<Window
    x:Class="DiametroLineaDesktop.Views.CompensateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Compensate"
    Width="380" SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="#12151C"
    FontFamily="Segoe UI"
    ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent"      Color="#2D7DD2"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E2E8F4"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#7A8499"/>
        <SolidColorBrush x:Key="BorderCol"   Color="#2E3548"/>
        <SolidColorBrush x:Key="InputBg"     Color="#232837"/>
    </Window.Resources>

    <Border Background="#1C2030" BorderBrush="#2E3548" BorderThickness="1" Margin="1">
        <StackPanel Margin="20">

            <!-- Heading -->
            <TextBlock Text="Compensate — target sink speed"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Every section is re-solved (mass-preserving, per 1 cm slice) so the whole line sinks at the same speed. The result is written to a separate C file — this design is not modified."
                       FontSize="11" Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MinLabel" Grid.Column="0" Text="—" FontSize="10"
                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <Slider x:Name="SpeedSlider" Grid.Column="1"
                        IsMoveToPointEnabled="True"
                        SmallChange="0.005" LargeChange="0.05"
                        ValueChanged="SpeedSlider_ValueChanged"
                        Margin="8,0"/>
                <TextBlock x:Name="MaxLabel" Grid.Column="2" Text="—" FontSize="10"
                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="SpeedValueLabel" Text="—"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent}"
                       HorizontalAlignment="Center" Margin="0,6,0,2"/>
            <TextBlock Text="The slider range is the slowest-to-fastest sink speed the current sections already reach — any target inside it is achievable by changing density alone."
                       FontSize="10" Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>

            <Rectangle Height="1" Fill="#2E3548" Margin="0,18,0,14"/>

            <TextBlock Text="Will be saved as:" FontSize="10"
                       Foreground="{StaticResource TextMuted}"/>
            <TextBlock x:Name="FileNameLabel" Text="—"
                       FontSize="11" Foreground="{StaticResource TextPrimary}"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>

            <Rectangle Height="1" Fill="#2E3548" Margin="0,14,0,14"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Create C file"
                        Click="OkBtn_Click" IsDefault="True"
                        Width="110" Height="30"
                        FontSize="12" FontWeight="SemiBold"
                        Foreground="White" BorderThickness="0"
                        Cursor="Hand" Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#2D7DD2" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.62"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Cancel"
                        Click="CancelBtn_Click"
                        IsCancel="True"
                        Width="90" Height="30"
                        FontSize="12"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#232837"
                                    BorderBrush="#2E3548" BorderThickness="1"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextBlock.Foreground="#7A8499"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
